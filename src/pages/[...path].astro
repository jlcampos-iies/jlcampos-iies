---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allRoutes } from '../lib/registry';
import { jsonLdBreadcrumb, jsonLdOrganization } from '../lib/seo';
import { pagePath } from '../i18n/routes';
import { t } from '../i18n/ui';
import Clients from '../views/Clients.astro';
import Contact from '../views/Contact.astro';
import Home from '../views/Home.astro';
import Project from '../views/Project.astro';
import Projects from '../views/Projects.astro';
import Prose from '../views/Prose.astro';
import Publications from '../views/Publications.astro';
import Studio from '../views/Studio.astro';
import Thanks from '../views/Thanks.astro';

export async function getStaticPaths() {
  const [routes, pages, projects] = await Promise.all([
    allRoutes(),
    getCollection('pages'),
    getCollection('projects'),
  ]);
  return routes.map((route) => {
    const entry =
      route.kind === 'page'
        ? pages.find((p) => p.data.key === route.key && p.data.lang === route.lang)
        : projects.find((p) => p.data.translationKey === route.key && p.data.lang === route.lang);
    if (!entry) throw new Error(`Sin contenido para ${route.path}`);
    return {
      params: { path: route.path.replace(/^\/|\/$/g, '') || undefined },
      props: { route, entry },
    };
  });
}

const { route, entry } = Astro.props;
const { lang, title, seoTitle, description } = entry.data;

const pageViews = {
  home: Home,
  studio: Studio,
  clients: Clients,
  projects: Projects,
  publications: Publications,
  contact: Contact,
  contactThanks: Thanks,
} as const;
const PageView = route.kind === 'page' ? (pageViews[route.key as keyof typeof pageViews] ?? Prose) : undefined;
const pageEntry = entry as CollectionEntry<'pages'>;
const projectEntry = entry as CollectionEntry<'projects'>;

const jsonLd: object[] = [];
if (route.kind === 'page' && route.key === 'home') jsonLd.push(jsonLdOrganization(lang));
if (route.kind === 'project') {
  jsonLd.push(
    jsonLdBreadcrumb([
      { name: t(lang, 'nav.home'), path: pagePath('home', lang) },
      { name: t(lang, 'nav.projects'), path: pagePath('projects', lang) },
      { name: title, path: route.path },
    ]),
  );
}
---
<Base
  lang={lang}
  title={title}
  seoTitle={seoTitle}
  description={description}
  path={route.path}
  alternates={route.alternates}
  noindex={route.noindex}
  jsonLd={jsonLd}
>
  {PageView ? <PageView entry={pageEntry} /> : <Project entry={projectEntry} />}
</Base>
