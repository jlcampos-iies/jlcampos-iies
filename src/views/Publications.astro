---
import { Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { t } from '../i18n/ui';

const MET = 'https://met.jlc-ingenieros.com/';

interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const { lang } = entry.data;
const books = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const { Content } = await render(entry);
const note = lang === 'es' ? '' : t(lang, 'met.spanishOnly');
// "Título (Máquinas y Equipos Térmicos I nº 2)" → título + serie en la línea siguiente
const splitTitle = (title: string) => {
  const m = title.match(/^(.*?)\s*\(([^()]+)\)$/);
  return m ? { main: m[1], series: m[2] } : { main: title, series: '' };
};
---
<div class="container page-content prose">
  <h1>{entry.data.title}</h1>
  <section class="met-card" aria-labelledby="met-title">
    <h2 id="met-title">{t(lang, 'met.title')}</h2>
    <p class="met-card__subtitle">{t(lang, 'met.subtitle')}</p>
    <h3>{t(lang, 'met.howTitle')}</h3>
    <ul class="met-card__list">
      <li>{t(lang, 'met.item1')}</li>
      <li>{t(lang, 'met.item2')}</li>
    </ul>
    <p class="met-card__value">{t(lang, 'met.value')}</p>
    <div class="actions">
      <span class="action">
        <a class="btn" href={`${MET}unidades/ud01-magnitudes/`} target="_blank" rel="noopener">{t(lang, 'met.tryFree')}</a>
        {note && <span class="btn-note">{note}</span>}
      </span>
      <span class="action">
        <a class="btn btn--secondary" href={`${MET}acceso/`} target="_blank" rel="noopener">{t(lang, 'met.haveBook')}</a>
        {note && <span class="btn-note">{note}</span>}
      </span>
    </div>
    <p class="met-card__fp">
      {t(lang, 'met.fpBefore')}<a href="mailto:info@jlc-ingenieros.com">{t(lang, 'met.fpLink')}</a>{t(lang, 'met.fpAfter')}
    </p>
  </section>
  <Content />
  <ul class="books">
    {
      books.map(({ data }) => (
        <li class="book">
          <Picture
            src={data.cover}
            formats={['avif', 'webp']}
            widths={[200, 400]}
            sizes="200px"
            alt={data.title[lang]}
            loading="lazy"
          />
          <div>
            <h2>
              {splitTitle(data.title[lang]).main}
              {splitTitle(data.title[lang]).series && <span class="book__series">{splitTitle(data.title[lang]).series}</span>}
            </h2>
            {data.inProgress && <p class="badge">{t(lang, 'publications.inProgress')}</p>}
            <p>{data.summary[lang]}</p>
            {data.amazon && (
              <p class="buy">
                <span class="buy__what">
                  <span class="buy__label">{t(lang, 'publications.buyLabel')}</span>
                  <span class="buy__scope">{data.unit ? `${t(lang, 'publications.unit')} ${data.unit}` : t(lang, 'publications.volume')}</span>
                </span>
                <span class="buy__links">
                  <a class="btn" href={`https://www.amazon.es/dp/${data.amazon.print}`} target="_blank" rel="noopener" aria-label={`${t(lang, 'publications.print')}: ${data.title[lang]}`}>{t(lang, 'publications.print')}</a>
                  <a class="btn" href={`https://www.amazon.es/dp/${data.amazon.kindle}`} target="_blank" rel="noopener" aria-label={`${t(lang, 'publications.kindle')}: ${data.title[lang]}`}>{t(lang, 'publications.kindle')}</a>
                </span>
              </p>
            )}
            <p class="buy">
              <a class="btn btn--secondary" href={data.companionUrl} target="_blank" rel="noopener">{t(lang, 'publications.companion')}</a>
              {note && <span class="btn-note">{note}</span>}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
