---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { pagePath } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const { title, description, hero, heroAlt, services = [], lang } = entry.data;
---
<section class="hero">
  {
    hero && heroAlt && (
      <Picture
        class="hero__img"
        src={hero}
        formats={['avif', 'webp']}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        alt={heroAlt}
        loading="eager"
      />
    )
  }
  <div class="container hero__inner">
    <div class="hero__text">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <a class="btn" href={pagePath('projects', lang)}>{t(lang, 'cta.viewProjects')}</a>
    </div>
  </div>
</section>
<section class="container page-content">
  <ul class="services">
    {
      services.map((s) => (
        <li class="service">
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </li>
      ))
    }
  </ul>
</section>
