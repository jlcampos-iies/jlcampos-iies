---
import { render, type CollectionEntry } from 'astro:content';
import { site } from '../config/site';
import { t } from '../i18n/ui';
import ContactForm from '../components/ContactForm.astro';
import Turnstile from '../components/Turnstile.astro';

interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const { lang } = entry.data;
const { Content } = await render(entry);
// tel: sin espacios ni paréntesis: (+34) 616 992 440 -> +34616992440
const telHref = `tel:${site.phone.replace(/[^\d+]/g, '')}`;
---
<div class="container page-content prose">
  <h1>{entry.data.title}</h1>
  <Content />
  <p class="contact-direct">
    {t(lang, 'contact.reachBefore')}<a href={`mailto:${site.email}`}>{site.email}</a>{t(lang, 'contact.reachMiddle')}<a href={telHref}>{site.phone}</a>{t(lang, 'contact.reachAfter')}
  </p>
  <section aria-labelledby="form-heading">
    <h2 id="form-heading">{t(lang, 'contact.formHeading')}</h2>
    <ContactForm lang={lang} />
    <Turnstile />
  </section>
</div>
