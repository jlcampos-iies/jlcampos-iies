---
import { Picture } from 'astro:assets';
import euFunded from '../assets/images/eu/ES_Financiado_por_la_Union_Europea_RGB_BLACK.png';
import euPlan from '../assets/images/eu/Plan-resiliencia.png';
import { site } from '../config/site';
import { pagePath, type Lang, type PageKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
const legal: { key: PageKey; label: UiKey }[] = [
  { key: 'legalNotice', label: 'footer.legalNotice' },
  { key: 'privacy', label: 'footer.privacy' },
  { key: 'cookies', label: 'footer.cookies' },
  { key: 'terms', label: 'footer.terms' },
];
---
<footer class="site-footer">
  <div class="container">
    <address>
      <strong>{site.name}</strong><br />
      {site.address.street}, {site.address.postalCode} {site.address.locality}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </address>
    <ul class="footer-legal">
      {
        legal.map(({ key, label }) => (
          <li>
            <a href={pagePath(key, lang)}>{t(lang, label)}</a>
          </li>
        ))
      }
    </ul>
    <div class="eu-funding">
      <Picture
        src={euFunded}
        formats={['webp']}
        fallbackFormat="png"
        widths={[230, 460]}
        sizes="230px"
        width={230}
        height={60}
        alt={t(lang, 'footer.euFunded')}
        loading="lazy"
        class="eu-funding__logo"
      />
      <Picture
        src={euPlan}
        formats={['webp']}
        fallbackFormat="png"
        widths={[183, 366]}
        sizes="183px"
        width={183}
        height={60}
        alt={t(lang, 'footer.euPlan')}
        loading="lazy"
        class="eu-funding__logo"
      />
    </div>
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>
