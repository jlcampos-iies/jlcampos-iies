{
  "name": "jlc-web-publica",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "astro check && astro build && node edge/build.mjs",
    "build:edge": "node edge/build.mjs",
    "test:unit": "astro sync && vitest run tests/unit --passWithNoTests",
    "test:dist": "vitest run tests/dist",
    "test": "npm run build && npm run test:unit && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "astro": "^7.4.1",
    "node-html-parser": "^9.0.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "html-validate": "^11.17.0",
    "sharp": "^0.35.5"
  }
}
